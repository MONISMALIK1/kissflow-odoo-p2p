# ── AI layer ────────────────────────────────────────────────────────────────
# AI_MODE=live  → calls Claude (needs ANTHROPIC_API_KEY)
# AI_MODE=offline → deterministic heuristic fallback, no API key needed (for demos)
AI_MODE=live
ANTHROPIC_API_KEY=sk-ant-...
# Default model. Opus 4.8 is the most capable; switch to claude-sonnet-4-6 for
# cheaper/faster high-volume runs.
ANTHROPIC_MODEL=claude-opus-4-8

# ── Odoo (system of record) ──────────────────────────────────────────────────
# ODOO_MODE=mock → reads/writes sample_data/odoo_seed.json, fakes IDs (no Odoo needed)
# ODOO_MODE=live → talks to a real Odoo instance over XML-RPC
ODOO_MODE=mock
ODOO_URL=https://your-company.odoo.com
ODOO_DB=your-company
ODOO_USERNAME=bot@your-company.com
ODOO_PASSWORD=your-odoo-api-key

# ── Kissflow (workflow layer) ────────────────────────────────────────────────
# KISSFLOW_MODE=mock → logs status sync to stdout (no Kissflow needed)
# KISSFLOW_MODE=live → posts status back to a Kissflow process item
KISSFLOW_MODE=mock
KISSFLOW_ACCOUNT_ID=your-account-id
KISSFLOW_BASE_URL=https://your-account-id.kissflow.com
KISSFLOW_PROCESS_ID=Purchase_Request
KISSFLOW_ACCESS_KEY_ID=your-access-key-id
KISSFLOW_ACCESS_KEY_SECRET=your-access-key-secret

# ── Business rules ───────────────────────────────────────────────────────────
# Requests at or under this total (in AED) may be auto-approved by the AI layer.
AUTO_APPROVE_LIMIT=5000
# A line price this many times the catalog price is flagged as a price anomaly.
PRICE_VARIANCE_FACTOR=1.25
